[Unit]
Description=i.datagon API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=i_datagon_ru_usr
Group=i_datagon_ru_usr
WorkingDirectory=/var/www/i_datagon_ru_usr/data/www/i.datagon.ru
EnvironmentFile=/var/www/i_datagon_ru_usr/data/www/i.datagon.ru/.env
ExecStart=/var/www/i_datagon_ru_usr/data/www/i.datagon.ru/.venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
